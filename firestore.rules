rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Exec: create events, run check-in/out QR codes, post announcements.
    // Granted by an admin from Manage Users, never self-service — see the
    // isExec-only update rule below.
    function isExec() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isExec == true;
    }

    // Users can read their own profile, or any profile if they're an admin
    // (the Manage Users roster). Only write their own. New users must be
    // created with isAdmin and isExec both false, and users cannot toggle
    // either on themselves.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.isAdmin == false
        && request.resource.data.isExec == false;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.isExec == resource.data.isExec;

      // Manage Users: an admin may flip isExec on any user, and nothing
      // else — isAdmin itself stays console-only, same as before.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isExec']);

      allow delete: if false;
    }

    // Events are readable by any authenticated user. Admins and exec can
    // create. Admins can edit or delete any event; exec can only edit or
    // delete events they created themselves — createdBy is pinned on
    // update so an exec can't reassign an event to someone else.
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() || isExec())
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (isExec()
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin()
        || (isExec() && resource.data.createdBy == request.auth.uid);
    }

    // Announcements are readable by any authenticated user. Admins and exec
    // can create; admins can edit or delete any, exec only their own --
    // same ownership pattern as events.
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() || isExec())
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (isExec()
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin()
        || (isExec() && resource.data.createdBy == request.auth.uid);
    }

    // Push tokens: one doc per member, keyed by uid, holding just their most
    // recent device's Expo push token -- nothing else about the person.
    // Deliberately its own collection, separate from `users`, so exec (who
    // can post announcements) can read what's needed to send a push without
    // also being able to read anyone's profile data.
    match /pushTokens/{uid} {
      allow read: if isAdmin() || isExec();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Check-ins: a user can create only their own record and read only their
    // own records. Admins can read all records (for attendance reporting).
    match /checkIns/{id} {
      // Two ways to prove a check-in is yours:
      //
      // 1. The doc ID. check-in.tsx names these `{uid}_{eventId}`, so the
      //    owner is in the name. This works even when the doc doesn't exist,
      //    which matters because the client looks for an existing check-in
      //    before writing one — without it, a member is denied on first scan.
      // 2. The doc contents, for check-ins saved under some other ID (e.g. an
      //    organizer marking someone present with an auto-generated ID).
      //
      // Neither path reveals whether someone else's check-in exists: a request
      // for another member's record is denied identically either way.
      allow read: if isSignedIn()
        && (id.split('_')[0] == request.auth.uid
            || (resource != null && resource.data.userId == request.auth.uid)
            || isAdmin());

      // Members write their own check-ins from the app, which means the client
      // supplies the point values — so the rules have to verify them against
      // the event itself. Without this, anyone could open a console and award
      // themselves any number they liked.
      //
      // Each half is only checked when it's actually present: a check-in write
      // carries pointsAwarded, a check-out write carries checkOutPointsAwarded,
      // and a merge write carries whichever half already existed.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && pointsMatchEvent(request.resource.data);

      // Updates are how the second half lands (setDoc with merge). The owner
      // may add to their record but never rewrite who it belongs to, which
      // event it's for, or a timestamp that's already been set.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.eventId == resource.data.eventId
        && pointsMatchEvent(request.resource.data)
        && timestampUnchanged('checkedInAt')
        && timestampUnchanged('checkedOutAt');

      allow delete: if isAdmin();
    }

    // RSVPs: readable by any signed-in member — same trust level as events
    // and announcements, since (unlike checkIns) RSVP carries no points and
    // isn't integrity-sensitive. A member may create or delete only their
    // own RSVP, keyed by doc ID the same way checkIns is (`{uid}_{eventId}`).
    match /rsvps/{id} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && id.split('_')[0] == request.auth.uid
        && id.split('_')[1] == request.resource.data.eventId
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn() && id.split('_')[0] == request.auth.uid;

      allow update: if false;
    }

    function eventOf(data) {
      return get(/databases/$(database)/documents/events/$(data.eventId)).data;
    }

    // Awarded points must equal what the event says that half is worth.
    function pointsMatchEvent(data) {
      return (!('pointsAwarded' in data)
              || data.pointsAwarded == eventOf(data).checkInPoints)
        && (!('checkOutPointsAwarded' in data)
            || data.checkOutPointsAwarded == eventOf(data).checkOutPoints);
    }

    // Once a half is recorded, its timestamp is frozen — so nobody can re-scan
    // to move their check-in time, and merge writes must carry it through
    // untouched.
    function timestampUnchanged(field) {
      return !(field in resource.data)
        || request.resource.data[field] == resource.data[field];
    }
  }
}
