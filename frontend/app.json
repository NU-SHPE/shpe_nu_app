{
  "expo": {
    "name": "SHPE App",
    "slug": "shpe-nu-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nu-shpe-icon.png",
    "scheme": "shpenuapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.northwestern.shpe.app"
    },
    "android": {
      "package": "edu.northwestern.shpe.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "name": "SHPE App",
      "shortName": "SHPE",
      "output": "static",
      "favicon": "./assets/images/nu-shpe-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SHPE App to access your camera to check in to events."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71c29a73-9bf1-4267-881c-23dc93be2cd7"
      }
    },
    "owner": "dpdoescode"
  }
}
